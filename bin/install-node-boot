#!/usr/bin/env bash
# Set up Termux:Boot on the S21 (the compute/brain phone) so the cluster
# self-heals after a reboot or an Android kill: SSH, Ollama and Kiwix all come
# back on their own — no need to pick up the phone.
#
# Run once on the S21:  ~/Home-Server/bin/install-node-boot
set -e

SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
BOOT="$HOME/.termux/boot"

mkdir -p "$BOOT"
cat > "$BOOT/20-nedory-node" <<EOF
#!/data/data/com.termux/files/usr/bin/sh
# Auto-generated by bin/install-node-boot — brings the S21 brain up on boot.
termux-wake-lock
# SSH first, so the S25's \`nedory\` can reach this phone even before Ollama is up.
sshd
exec "$ROOT/bin/nedory-node"
EOF
chmod +x "$BOOT/20-nedory-node"

echo "◢ S21 boot script installed → $BOOT/20-nedory-node"
echo
echo "  Two things Android needs, or it silently won't run:"
echo "   1) Open the 'Termux:Boot' app once from your launcher (enables boot hooks)."
echo "   2) Settings → Apps → Termux → Battery → Unrestricted (so it isn't killed)."
echo
echo "  Reboot to test: SSH + Ollama + Kiwix should come up by themselves,"
echo "  and \`nedory\` on the S25 will find the brain already awake."
