#!/usr/bin/env bash
# Sets up Termux:Boot to auto-start the Home Server dashboard on phone boot.
# Run once on the app device (e.g. the S25):  ~/Home-Server/bin/install-boot
set -e

SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
BOOT="$HOME/.termux/boot"

mkdir -p "$BOOT"
cat > "$BOOT/10-nedory" <<EOF
#!/data/data/com.termux/files/usr/bin/sh
# Auto-generated by bin/install-boot — starts the Home Server dashboard on boot.
termux-wake-lock
exec "$ROOT/bin/nedory"
EOF
chmod +x "$BOOT/10-nedory"

echo "◢ Boot script installed → $BOOT/10-nedory"
echo
echo "  Two things Android needs, or it silently won't run:"
echo "   1) Open the 'Termux:Boot' app once from your launcher (enables boot hooks)."
echo "   2) Settings → Apps → Termux → Battery → Unrestricted (so it isn't killed)."
echo
echo "  Reboot to test. The dashboard will come up on http://localhost:3000 by itself."
