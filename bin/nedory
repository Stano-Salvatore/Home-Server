#!/usr/bin/env bash
# Nedory — one command to bring the whole workspace up from the S25.
#
#   nedory          (re)start everything: compute nodes (if configured) + local
#                   Ollama (if installed) + the dashboard
#   nedory update   git pull + rebuild, then restart everything
#   nedory status   check every service in the cluster
#   nedory stop     stop the local dashboard
#
# To also wake compute nodes (S21, U10, …) automatically, copy .nedory.env.example
# to .nedory.env and set <NODE>_SSH for each (needs an sshd running there — see that file).
set -e

# Resolve the repo root even when this is invoked via a symlink on PATH.
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
cd "$ROOT"

# Self-heal: symlink every other bin/ script onto PATH too, so new helper
# scripts (get-zim, install-vulkan-llama, ...) become bare commands with no
# separate manual symlink step for each one we add later. Defined as a function
# so `nedory update` can re-run it *after* git pull — otherwise a script added
# in that pull isn't symlinked until the next nedory run, so it's still
# "command not found" on the very run that fetched it.
BIN_DIR="${PREFIX:-$HOME/.local}/bin"
relink_helpers() {
  mkdir -p "$BIN_DIR" 2>/dev/null || true
  for script in "$ROOT"/bin/*; do
    name="$(basename "$script")"
    [ -x "$script" ] || continue
    target="$BIN_DIR/$name"
    [ -L "$target" ] && [ "$(readlink -f "$target" 2>/dev/null)" = "$script" ] && continue
    ln -sf "$script" "$target" 2>/dev/null || true
  done
}
relink_helpers

# Optional per-device config (S21_SSH, S21_OLLAMA, S21_KIWIX, etc.).
[ -f "$ROOT/.nedory.env" ] && . "$ROOT/.nedory.env"

# Fixed name so re-running `nedory` always finds (and replaces) the same
# session instead of piling up duplicates.
TMUX_SESSION="nedory"

# Stop whatever is serving on :3000. Next spawns a child `next-server` that
# actually holds the socket, so killing only `next start` leaves the port taken
# (hello, EADDRINUSE). Kill both, and fall back to freeing the port directly.
stop_running() {
  command -v tmux >/dev/null 2>&1 && tmux kill-session -t "$TMUX_SESSION" 2>/dev/null || true
  pkill -f "next start"  2>/dev/null || true
  pkill -f "next-server" 2>/dev/null || true
  command -v fuser >/dev/null 2>&1 && fuser -k 3000/tcp 2>/dev/null || true
  sleep 1
}

if [ "$1" = "stop" ]; then
  stop_running
  echo "◢ Nedory: dashboard stopped."
  exit 0
fi

if [ "$1" = "status" ]; then
  check() { # label url
    if curl -sf -m 4 "$2" >/dev/null 2>&1; then
      printf '  \033[32m✓\033[0m %s\n' "$1"
    else
      printf '  \033[31m✗\033[0m %s  \033[2m%s\033[0m\n' "$1" "$2"
    fi
  }
  echo "◢ Nedory cluster status"
  check "dashboard (this phone)" "http://localhost:3000"
  check "S21 · Ollama"          "${S21_OLLAMA:-http://100.126.149.29:11434}/api/tags"
  check "S21 · Kiwix"           "${S21_KIWIX:-http://100.126.149.29:8080}"
  if [ -n "${U10_SSH:-}" ]; then
    check "U10 · Ollama"        "${U10_OLLAMA:-http://100.120.92.95:11434}/api/tags"
    check "U10 · Kiwix"         "${U10_KIWIX:-http://100.120.92.95:8080}"
  fi
  command -v ollama >/dev/null 2>&1 && check "local Ollama (embeddings)" "http://localhost:11434/api/tags"
  exit 0
fi

# Best-effort: keep Termux awake so Android doesn't kill anything we start.
command -v termux-wake-lock >/dev/null 2>&1 && termux-wake-lock || true

if [ "$1" = "update" ]; then
  echo "◢ Nedory: pulling the latest…"
  git pull
  relink_helpers   # re-symlink now that the pull may have added new bin/ helpers
  npm install
  npm run build
fi

# 1) Wake compute nodes (Ollama + Kiwix) over Tailscale, if configured.
wake_node() { # name ssh
  local name="$1" ssh="$2"
  [ -n "$ssh" ] || return 0
  echo "◢ Waking the $name…"
  if $ssh 'bash -lc "~/Home-Server/bin/nedory-node"' </dev/null >/dev/null 2>&1; then
    echo "  ✓ $name up (Ollama + Kiwix)"
  else
    echo "  ⚠ couldn't reach the $name — is sshd running there? (check ${name}_SSH in .nedory.env)"
  fi
}
wake_node "S21" "${S21_SSH:-}"
wake_node "U10" "${U10_SSH:-}"

# 2) Local Ollama on this phone, if installed (e.g. for on-device embeddings).
if command -v ollama >/dev/null 2>&1 && ! pgrep -f "ollama serve" >/dev/null 2>&1; then
  OLLAMA_HOST=0.0.0.0:11434 OLLAMA_KEEP_ALIVE=30m nohup ollama serve >"$HOME/ollama.log" 2>&1 &
  echo "◢ Local Ollama serving on :11434"
fi

# 2b) Local litert-lm serve — the always-available on-device chat model, so
# `nedory` is the single command that brings the whole thing up (no more
# "remember to start litert-lm too"). Started in tmux like the dashboard so
# Android doesn't kill it once backgrounded. Port defaults to 9379 to match the
# app's litertlmBaseUrl setting; override with LITERTLM_PORT in .nedory.env if
# you've changed it there. Skipped when the CLI isn't installed or it's already
# running; if no model is imported yet, run `install-litert-lm` once first.
if command -v litert-lm >/dev/null 2>&1 && command -v tmux >/dev/null 2>&1 \
    && ! pgrep -f "litert-lm serve" >/dev/null 2>&1; then
  tmux new-session -d -s litert-lm "litert-lm serve --port ${LITERTLM_PORT:-9379}"
  echo "◢ litert-lm serving on :${LITERTLM_PORT:-9379} (tmux session 'litert-lm')"
fi

# 3) The dashboard.
if [ ! -d .next ]; then
  echo "◢ Nedory: first build, one moment…"
  npm run build
fi

stop_running   # free the port so this run replaces any old instance
echo "◢ Nedory online  →  http://localhost:3000"

if command -v tmux >/dev/null 2>&1; then
  # Detached tmux session, not a bare foreground `exec`: every scheduled Task
  # (Tasks page → cron/file-watch) runs through node-cron timers living
  # inside this same long-running process, so it has to survive the terminal
  # losing focus or being closed — exactly the reliability problem tmux
  # already solves for litert-lm serve elsewhere in this fleet. A bare `exec`
  # ties the dashboard's lifetime to whatever single terminal tab happened to
  # invoke `nedory`; termux-wake-lock alone doesn't prevent Android from
  # backgrounding/killing that tab, which is why scheduled Tasks can look
  # like they work during a live test (screen on, Termux frontmost) and then
  # silently never fire once the phone actually locks.
  tmux new-session -d -s "$TMUX_SESSION" "cd '$ROOT' && exec npm run start"
  echo "  running in tmux session '$TMUX_SESSION' — reattach any time with: tmux attach -t $TMUX_SESSION"
else
  echo "  ⚠ tmux not found — running in the foreground of this shell instead."
  echo "    Scheduled Tasks need this process to keep running in the background:"
  echo "    pkg install tmux, then run nedory again — otherwise keep this session open."
  exec npm run start
fi
