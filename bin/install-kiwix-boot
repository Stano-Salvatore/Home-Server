#!/usr/bin/env bash
# Set up Termux:Boot on a library box (e.g. the Doogee tablet) so kiwix-serve
# comes back on its own after a reboot.
#
# Run once:  ~/Home-Server/bin/install-kiwix-boot
# If your ZIMs live on an SD card, pass the dir:  ZIM_DIR=/storage/XXXX-XXXX/zim ~/Home-Server/bin/install-kiwix-boot
set -e

SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
BOOT="$HOME/.termux/boot"
ZIM_DIR="${ZIM_DIR:-$HOME/zim}"

mkdir -p "$BOOT"
cat > "$BOOT/15-nedory-kiwix" <<EOF
#!/data/data/com.termux/files/usr/bin/sh
# Auto-generated by bin/install-kiwix-boot — serves offline Wikipedia on boot.
termux-wake-lock
ZIM_DIR="$ZIM_DIR" exec "$ROOT/bin/nedory-kiwix"
EOF
chmod +x "$BOOT/15-nedory-kiwix"

echo "◢ Kiwix boot script installed → $BOOT/15-nedory-kiwix  (ZIM_DIR=$ZIM_DIR)"
echo
echo "  Android needs, or it won't run on boot:"
echo "   1) Open the 'Termux:Boot' app once from the launcher."
echo "   2) Settings → Apps → Termux → Battery → Unrestricted."
echo
echo "  Reboot to test — kiwix-serve should come up on :8080 by itself."
