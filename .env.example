# Copy to .env.local and adjust. All of these are also editable from /settings at runtime.

# Path to an existing Obsidian vault folder (leave blank to disable two-way sync)
VAULT_PATH=

# Folder containing your .epub / .pdf files for the Library
LIBRARY_PATH=./data/library

# Folder for uploaded files/photos
UPLOADS_PATH=./data/uploads

# Path to the llama-server binary (llama.cpp), or just the command name if on PATH
LLAMACPP_BIN_PATH=llama-server

# Base URL of a running Ollama instance
OLLAMA_HOST=http://127.0.0.1:11434

# Ollama model used to generate embeddings for Brain (RAG)
EMBEDDING_MODEL=nomic-embed-text
