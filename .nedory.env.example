# Copy to .nedory.env to have `nedory` also wake the S21 compute node.
#
# One-time setup on the S21 (the brain phone), in its Termux:
#   pkg install openssh
#   sshd                       # starts an SSH server on port 8022
#   whoami                     # note the username (e.g. u0_a300)
# Then from the S25, copy your key over once so no password is needed:
#   ssh-keygen -t ed25519      # if you don't already have a key
#   ssh-copy-id -p 8022 <user>@100.126.149.29
#
# Now set S21_SSH to the ssh command that reaches the S21:
S21_SSH="ssh -p 8022 u0_a300@100.126.149.29"
